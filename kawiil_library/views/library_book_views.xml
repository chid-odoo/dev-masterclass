<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Book list view -->
    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.view.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-muted="state == 'checked_out'">
                <field name="title"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'available'"
                    decoration-warning="state == 'checked_out'"/>
                <field name="active_checkout_id" optional="show"/>
                <field name="checkout_count" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Book form view -->
    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.view.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="available,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Book Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="author"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="active_checkout_id" readonly="1"/>
                            <field name="checkout_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkout History">
                            <field name="checkout_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="checkout_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'returned'"
                                        decoration-warning="state == 'ongoing'"
                                        decoration-danger="state == 'overdue'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Book action -->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
