<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Checkout list view -->
    <record id="library_checkout_view_list" model="ir.ui.view">
        <field name="name">library.checkout.view.list</field>
        <field name="model">library.checkout</field>
        <field name="arch" type="xml">
            <list string="Checkouts"
                decoration-danger="state == 'overdue'"
                decoration-muted="state == 'returned'">
                <field name="name"/>
                <field name="book_id"/>
                <field name="partner_id"/>
                <field name="checkout_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'returned'"
                    decoration-warning="state == 'ongoing'"
                    decoration-danger="state == 'overdue'"/>
            </list>
        </field>
    </record>

    <!-- Checkout form view -->
    <record id="library_checkout_view_form" model="ir.ui.view">
        <field name="name">library.checkout.view.form</field>
        <field name="model">library.checkout</field>
        <field name="arch" type="xml">
            <form string="Checkout">
                <header>
                    <button name="action_return" string="Return Book"
                        type="object" class="btn-primary"
                        invisible="state != 'ongoing'"/>
                    <button name="action_mark_overdue" string="Mark Overdue"
                        type="object" class="btn-warning"
                        invisible="state != 'ongoing'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="ongoing,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Checkout Details">
                            <field name="book_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Dates">
                            <field name="checkout_date"/>
                            <field name="due_date"/>
                            <field name="return_date" readonly="1"
                                invisible="state == 'ongoing'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Checkout action -->
    <record id="library_checkout_action" model="ir.actions.act_window">
        <field name="name">Checkouts</field>
        <field name="res_model">library.checkout</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Active checkouts action (only ongoing/overdue) -->
    <record id="library_checkout_active_action" model="ir.actions.act_window">
        <field name="name">Active Checkouts</field>
        <field name="res_model">library.checkout</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("state", "in", ["ongoing", "overdue"])]</field>
    </record>

    <!-- Sequence for checkout references -->
    <record id="library_checkout_sequence" model="ir.sequence">
        <field name="name">Library Checkout</field>
        <field name="code">library.checkout</field>
        <field name="prefix">LIB/</field>
        <field name="padding">4</field>
    </record>

</odoo>
